<% const pageStyles = ["catalog.css", "course-media.css"]; const pageScripts = ["course-images.js"]; const catalogFilters = typeof filters !== "undefined" ? filters : { search: search || "", category: "", level: "", sort: "newest" }; const catalogCategories = typeof categories !== "undefined" ? categories : []; %><%- include("../header", { pageStyles }) %>
<section class="page-heading"><p class="eyebrow">Catalog</p><h1>Khóa học đã xuất bản</h1><p>Tìm khóa học phù hợp và bắt đầu hành trình học tập.</p></section>
<section class="card catalog-toolbar"><form method="get" action="/courses" class="catalog-search"><label for="course-search">Tìm theo tên khóa học</label><div class="search-row"><input id="course-search" name="q" value="<%= catalogFilters.search %>" maxlength="255"><button class="button">Tìm kiếm</button></div><div class="filter-row"><label>Danh mục<select name="category"><option value="">Tất cả</option><% catalogCategories.forEach((category)=> { %><option value="<%= category %>" <%= catalogFilters.category===category?"selected":"" %>><%= category %></option><% }) %></select></label><label>Trình độ<select name="level"><option value="">Tất cả</option><option value="beginner" <%= catalogFilters.level==="beginner"?"selected":"" %>>Cơ bản</option><option value="intermediate" <%= catalogFilters.level==="intermediate"?"selected":"" %>>Trung cấp</option><option value="advanced" <%= catalogFilters.level==="advanced"?"selected":"" %>>Nâng cao</option></select></label><label>Sắp xếp<select name="sort"><option value="newest" <%= catalogFilters.sort==="newest"?"selected":"" %>>Mới cập nhật</option><option value="title" <%= catalogFilters.sort==="title"?"selected":"" %>>Tên A–Z</option><option value="popular" <%= catalogFilters.sort==="popular"?"selected":"" %>>Nhiều học viên</option></select></label><button class="button secondary">Áp dụng</button><a class="button ghost clear-filter" href="/courses">Xóa lọc</a></div></form></section>
<% if(!courses.length){ %><section class="card empty-state"><h2>Không tìm thấy khóa học</h2><p>Hãy thử từ khóa hoặc bộ lọc khác. Catalog chỉ hiển thị khóa đã xuất bản.</p></section><% } else { %><section class="card-grid"><% courses.forEach((course)=> { const coverUrl = course.cover_image_url || course.fallback_cover_image_url || "/images/course-covers/default.svg"; const fallbackCoverUrl = course.fallback_cover_image_url || "/images/course-covers/default.svg"; %><article class="card course-card"><div class="course-cover-frame" data-cover-frame><img class="course-cover" data-course-cover data-cover-fallback="<%= fallbackCoverUrl %>" src="<%= coverUrl %>" alt="Ảnh bìa khóa <%= course.title %>"><span class="course-cover-placeholder" aria-hidden="true">Chưa có ảnh bìa</span></div><span class="badge published"><%= course.category %> · <%= course.level %></span><h2><a href="/courses/<%= course.id %>"><%= course.title %></a></h2><p><%= course.short_description || course.description || "Khóa học chưa có mô tả." %></p><p class="muted"><%= course.enrollment_count %> học viên</p><a class="text-link" href="/courses/<%= course.id %>">Xem chi tiết →</a></article><% }) %></section><% } %>
<%- include("../footer") %>