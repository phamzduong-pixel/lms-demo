<% const pageStyles = ["catalog.css", "course-media.css"]; const pageScripts = ["course-images.js"]; %><%- include("../header", { pageStyles }) %>
<section class="page-heading"><a class="back-link" href="/courses">← Tất cả khóa học</a><span class="badge published"><%= course.category %> · <%= course.level %></span><h1><%= course.title %></h1><p class="lead"><%= course.short_description || course.description || "Khóa học chưa có mô tả." %></p></section>
<% if(message){ %><div class="alert success"><%= message %></div><% } %><% if(error){ %><div class="alert error"><%= error %></div><% } %>
<section class="card course-detail"><div class="course-cover-frame detail-cover-frame <%= course.cover_image_url ? "" : "is-placeholder" %>" data-cover-frame<% if (!course.cover_image_url) { %> role="img" aria-label="Khóa học chưa có ảnh bìa"<% } %>><% if(course.cover_image_url){ %><img class="course-cover" data-course-cover src="<%= course.cover_image_url %>" alt="Ảnh bìa khóa <%= course.title %>"><% } %><span class="course-cover-placeholder" aria-hidden="true">Chưa có ảnh bìa</span></div><p><%= course.description || "Khóa học chưa có mô tả chi tiết." %></p><h2>Mục tiêu học tập</h2><pre class="plain-text"><%= course.learning_objectives || "Mục tiêu học tập sẽ được cập nhật." %></pre><p class="muted"><%= lessons.length %> bài học · <%= course.enrollment_count %> học viên · <%= reviewSummary.review_count %> đánh giá (<%= reviewSummary.average_rating %>/5)</p><div class="actions"><% if(currentUser&&currentUser.role==="student"){if(enrolled){ %><a class="button" href="/student/courses/<%= course.id %>">Mở khóa học</a><% }else{%><form method="post" action="/courses/<%= course.id %>/enroll"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button">Đăng ký khóa học</button></form><% }}else if(!currentUser){ %><a class="button" href="/login?next=/courses/<%= course.id %>">Đăng nhập để đăng ký</a><% } %></div></section>
<section class="card"><h2>Nội dung khóa học</h2><ol class="lesson-list"><% lessons.forEach((lesson)=>{ %><li><span class="lesson-number"><%= lesson.position %></span><%= lesson.title %></li><% }) %></ol></section>
<section class="card"><h2>Đánh giá học viên</h2><% if(enrolled){ %><form method="post" action="/student/courses/<%= course.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Điểm<select name="rating"><% for(let i=1;i<=5;i++){ %><option value="<%= i %>" <%= ownReview&&Number(ownReview.rating)===i?"selected":"" %>><%= i %> sao</option><% } %></select></label><label>Nhận xét<textarea name="comment" required maxlength="2000"><%= ownReview ? ownReview.comment : "" %></textarea></label><button class="button">Lưu đánh giá</button></form><% if(ownReview){ %><form method="post" action="/student/courses/<%= course.id %>/review/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary">Xóa đánh giá của tôi</button></form><% }}else{ %><p class="muted">Đăng ký khóa học để viết đánh giá.</p><% } %><% reviews.forEach((review)=>{ %><article class="review"><strong><%= review.full_name %></strong> · <%= review.rating %>/5<p><%= review.comment %></p></article><% }) %></section>
<%- include("../footer") %>