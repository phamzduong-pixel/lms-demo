<% const pageStyles = ["auth.css"]; const pageScripts = ["auth.js"]; const pageClass = "auth-page"; %>
<%- include("header", { pageStyles, pageClass }) %>
<section class="auth-shell" aria-labelledby="register-title">
  <article class="auth-card auth-card-wide">
    <div class="auth-intro">
      <span class="auth-kicker"><span aria-hidden="true"></span> Bắt đầu hành trình học tập</span>
      <h1 id="register-title">Đăng ký học viên</h1>
      <p>Tạo tài khoản để đăng ký khóa học và theo dõi tiến độ của bạn.</p>
    </div>
    <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
    <form class="auth-form" method="post" action="/register">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="auth-field" for="register-name"><span class="field-label">Họ và tên</span><span class="auth-input-wrap"><span class="input-icon" aria-hidden="true">●</span><input id="register-name" name="full_name" value="<%= values.full_name || '' %>" required minlength="2" maxlength="150" autocomplete="name" placeholder="Nguyễn Văn A"></span></label>
      <label class="auth-field" for="register-email"><span class="field-label">Email</span><span class="auth-input-wrap"><span class="input-icon" aria-hidden="true">@</span><input id="register-email" type="email" name="email" value="<%= values.email || '' %>" required maxlength="255" autocomplete="email" placeholder="tenhocvien@example.com"></span></label>
      <label class="auth-field" for="register-password"><span class="field-label">Mật khẩu</span><span class="auth-input-wrap has-toggle"><span class="input-icon" aria-hidden="true">●</span><input id="register-password" type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự"><button class="password-toggle" type="button" data-password-toggle aria-controls="register-password" aria-label="Hiện mật khẩu" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c5.2 0 8.9 5.4 9 5.6a1 1 0 0 1 0 .8C20.9 11.6 17.2 17 12 17s-8.9-5.4-9-5.6a1 1 0 0 1 0-.8C3.1 10.4 6.8 5 12 5Zm0 2c-3.3 0-6 3-7 4 1 1 3.7 4 7 4s6-3 7-4c-1-1-3.7-4-7-4Zm0 1.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z"/></svg></button></span></label>
      <label class="auth-field" for="register-confirm"><span class="field-label">Nhập lại mật khẩu</span><span class="auth-input-wrap has-toggle"><span class="input-icon" aria-hidden="true">●</span><input id="register-confirm" type="password" name="confirm_password" required minlength="8" autocomplete="new-password" placeholder="Nhập lại mật khẩu"><button class="password-toggle" type="button" data-password-toggle aria-controls="register-confirm" aria-label="Hiện mật khẩu" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c5.2 0 8.9 5.4 9 5.6a1 1 0 0 1 0 .8C20.9 11.6 17.2 17 12 17s-8.9-5.4-9-5.6a1 1 0 0 1 0-.8C3.1 10.4 6.8 5 12 5Zm0 2c-3.3 0-6 3-7 4 1 1 3.7 4 7 4s6-3 7-4c-1-1-3.7-4-7-4Zm0 1.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z"/></svg></button></span></label>
      <button class="button auth-submit" type="submit">Tạo tài khoản <span aria-hidden="true">→</span></button>
    </form>
    <p class="auth-switch">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
  </article>
</section>
<%- include("footer", { pageScripts }) %>
