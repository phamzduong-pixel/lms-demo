<% const pageStyles = ["admin.css"]; %>
<%- include("../../header", { pageStyles }) %>
<section class="page-heading"><a class="back-link" href="/admin/teachers">← Quản lý giáo viên</a><p class="eyebrow">TÀI KHOẢN NỘI BỘ</p><h1><%= heading %></h1><p class="lead">Vai trò được server cố định là giáo viên. Mật khẩu luôn được băm bằng bcrypt.</p></section>
<section class="card narrow teacher-form-card">
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <form method="post" action="<%= formAction %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Họ tên<input name="full_name" value="<%= values.fullName %>" maxlength="150" required autocomplete="name"></label>
    <label>Email<input type="email" name="email" value="<%= values.email %>" maxlength="255" required autocomplete="email"></label>
    <% if (!editing) { %><label>Mật khẩu tạm thời<input type="password" name="password" minlength="8" required autocomplete="new-password"></label><label>Xác nhận mật khẩu<input type="password" name="confirm_password" minlength="8" required autocomplete="new-password"></label><% } %>
    <div class="form-actions"><button class="button" type="submit"><%= editing ? "Lưu thay đổi" : "Tạo tài khoản" %></button><a class="button secondary" href="/admin/teachers">Hủy</a></div>
  </form>
</section>
<%- include("../../footer") %>
