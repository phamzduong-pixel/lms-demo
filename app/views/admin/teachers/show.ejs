<% const pageStyles = ["admin.css"]; %>
<%- include("../../header", { pageStyles }) %>
<section class="page-heading split-heading"><div><a class="back-link" href="/admin/teachers">← Quản lý giáo viên</a><p class="eyebrow">TÀI KHOẢN GIÁO VIÊN</p><h1><%= teacher.full_name %></h1><p class="lead"><%= teacher.email %></p></div><div class="form-actions"><a class="button secondary" href="/admin/teachers/<%= teacher.id %>/edit">Sửa thông tin</a><a class="button secondary" href="/admin/teachers/<%= teacher.id %>/password">Đặt lại mật khẩu</a></div></section>
<% if (message) { %><div class="alert success" role="status"><%= message %></div><% } %>
<section class="card teacher-detail-summary"><div><span class="muted">Trạng thái</span><strong class="status-badge <%= teacher.is_active ? "status-active" : "status-locked" %>"><%= teacher.status_label %></strong></div><div><span class="muted">Ngày tạo</span><strong><%= teacher.created_at_label %></strong></div><div><span class="muted">Khóa phụ trách</span><strong><%= courses.length %></strong></div><form method="post" action="/admin/teachers/<%= teacher.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= teacher.is_active ? "locked" : "active" %>"><button class="button <%= teacher.is_active ? "danger" : "secondary" %>" type="submit"><%= teacher.is_active ? "Khóa tài khoản" : "Mở khóa tài khoản" %></button></form></section>
<section class="card table-card"><div class="table-heading"><div><h2>Khóa học được phân công</h2><p class="muted">Chuyển phân công tại khu vực quản trị khóa học.</p></div></div><% if (!courses.length) { %><div class="empty-state"><h3>Chưa phụ trách khóa học</h3><p>Giáo viên này chưa được phân công khóa học nào.</p></div><% } else { %><div class="table-wrap"><table class="data-table"><thead><tr><th>Khóa học</th><th>Trạng thái</th><th>Bài học</th><th>Học viên</th><th>Cập nhật</th></tr></thead><tbody><% courses.forEach((course) => { %><tr><td data-label="Khóa học"><strong><%= course.title %></strong></td><td data-label="Trạng thái"><%= course.status === "published" ? "Đã xuất bản" : "Bản nháp" %></td><td data-label="Bài học"><%= course.lesson_count %></td><td data-label="Học viên"><%= course.enrollment_count %></td><td data-label="Cập nhật"><%= course.updated_at_label %></td></tr><% }) %></tbody></table></div><% } %></section>
<%- include("../../footer") %>
