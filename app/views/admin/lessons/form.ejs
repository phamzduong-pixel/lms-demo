<% const pageStyles = ["admin.css"]; %>
<%- include("../../header", { pageStyles }) %>
<section class="page-heading">
  <a class="back-link" href="/admin/courses/<%= course.id %>/lessons">← Danh sách bài học</a>
  <h1><%= heading %></h1>
  <p><%= course.title %></p>
</section>
<section class="card">
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="<%= formAction %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Tiêu đề bài học
      <input name="title" value="<%= values.title || '' %>" required maxlength="255">
    </label>
    <label>Vị trí
      <input type="number" name="position" value="<%= values.position || '' %>" required min="1" step="1">
    </label>
    <label>Nội dung bài học
      <textarea name="content" rows="16" maxlength="1000000"><%= values.content || '' %></textarea>
    </label>
    <p class="muted">Nội dung sẽ được hiển thị như văn bản thường.</p>
    <div class="actions">
      <button class="button" type="submit">Lưu bài học</button>
      <a class="button secondary" href="/admin/courses/<%= course.id %>/lessons">Hủy</a>
    </div>
  </form>
</section>
<%- include("../../footer") %>