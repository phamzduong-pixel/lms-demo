<% const pageStyles = ["admin.css"]; %>
<%- include("../../header") %>
<section class="page-heading">
  <a class="back-link" href="/admin">← Quản lý khóa học</a>
  <h1><%= heading %></h1>
</section>
<section class="card narrow">
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="post" action="<%= formAction %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Tên khóa học
      <input name="title" value="<%= values.title || '' %>" required maxlength="255">
    </label>
    <label>Mô tả
      <textarea name="description" rows="6" maxlength="100000"><%= values.description || '' %></textarea>
    </label>
    <div class="actions">
      <button class="button" type="submit">Lưu khóa học</button>
      <a class="button secondary" href="/admin">Hủy</a>
    </div>
  </form>
</section>
<%- include("../../footer") %>