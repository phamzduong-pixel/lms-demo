<% const pageStyles=["admin.css"]; %><%- include("../../header",{pageStyles}) %>
<section class="page-heading"><a class="back-link" href="/admin">← Quản lý khóa học</a><h1><%= heading %></h1></section>
<section class="card narrow"><% if(error){ %><div class="alert error"><%= error %></div><% } %><form method="post" action="<%= formAction %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Tên khóa học<input name="title" value="<%= values.title || '' %>" required maxlength="255"></label><label>Mô tả<textarea name="description" rows="5"><%= values.description || '' %></textarea></label><label>Danh mục<input name="category" value="<%= values.category || '' %>" required maxlength="100"></label><label>Trình độ<select name="level"><option value="beginner" <%= values.level==='beginner'?'selected':'' %>>Cơ bản</option><option value="intermediate" <%= values.level==='intermediate'?'selected':'' %>>Trung cấp</option><option value="advanced" <%= values.level==='advanced'?'selected':'' %>>Nâng cao</option></select></label><label>URL ảnh bìa<input type="url" name="cover_image_url" value="<%= values.coverImageUrl || values.cover_image_url || '' %>"></label><label>Mô tả ngắn<textarea name="short_description"><%= values.shortDescription || values.short_description || '' %></textarea></label><label>Mục tiêu học tập<textarea name="learning_objectives"><%= values.learningObjectives || values.learning_objectives || '' %></textarea></label><button class="button">Lưu khóa học</button></form></section><%- include("../../footer") %>