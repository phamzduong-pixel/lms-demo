<% const pageStyles = ["admin.css"]; %>
<%- include("../../header", { pageStyles }) %>
<section class="page-heading split-heading">
  <div>
    <a class="back-link" href="/admin/students">← Danh sách học viên</a>
    <p class="eyebrow">TÀI KHOẢN HỌC VIÊN</p>
    <h1><%= student.full_name %></h1>
    <p class="lead"><%= student.email %></p>
  </div>
  <div class="form-actions">
    <a class="button secondary" href="/admin/students/<%= student.id %>/edit">Sửa thông tin</a>
    <a class="button secondary" href="/admin/students/<%= student.id %>/password">Đặt lại mật khẩu</a>
  </div>
</section>
<% if (message) { %><div class="alert success" role="status"><%= message %></div><% } %>
<section class="card teacher-detail-summary">
  <div><span class="muted">Trạng thái</span><strong class="status-badge <%= student.is_active ? "status-active" : "status-locked" %>"><%= student.status_label %></strong></div>
  <div><span class="muted">Ngày tạo</span><strong><%= student.created_at_label %></strong></div>
  <div><span class="muted">Khóa đã đăng ký</span><strong><%= courses.length %></strong></div>
  <form method="post" action="/admin/students/<%= student.id %>/status">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="status" value="<%= student.is_active ? "inactive" : "active" %>">
    <button class="button <%= student.is_active ? "danger" : "secondary" %>" type="submit"><%= student.is_active ? "Ngừng hoạt động" : "Kích hoạt lại" %></button>
  </form>
</section>
<section class="page-heading compact-heading"><h2>Khóa học đã đăng ký</h2></section>
<% if (!courses.length) { %>
  <section class="card empty-state"><p>Học viên chưa đăng ký khóa học nào.</p></section>
<% } else { %>
  <section class="admin-list">
    <% courses.forEach((course) => {
      const total = Number(course.total_lessons || 0);
      const completed = Number(course.completed_lessons || 0);
      const percent = total ? Math.round((completed / total) * 100) : 0;
    %><article class="card student-course-row">
      <div><div class="section-heading"><h3><%= course.title %></h3><span class="badge <%= course.status === 'published' ? 'published' : 'draft' %>"><%= course.status === 'published' ? 'Đã xuất bản' : 'Bản nháp' %></span></div>
      <p class="muted"><%= total ? (completed + "/" + total + " bài học hoàn thành") : "Chưa có bài học" %> · Đăng ký <%= course.enrolled_at || "—" %></p></div>
      <div class="student-progress-summary"><% if (total) { %><strong><%= percent %>%</strong><progress value="<%= completed %>" max="<%= total %>"></progress><% } else { %><span class="muted">—</span><% } %><a class="text-link" href="/admin/courses/<%= course.id %>/students">Học viên theo khóa</a></div>
    </article><% }) %>
  </section>
<% } %>
<%- include("../../footer") %>