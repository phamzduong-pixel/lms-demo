<% const pageStyles = ["admin.css"]; %>
<%- include("../../header", { pageStyles }) %>
<section class="page-heading">
  <a class="back-link" href="/admin/students/<%= student.id %>">← Chi tiết học viên</a>
  <p class="eyebrow">BẢO MẬT TÀI KHOẢN</p>
  <h1>Đặt lại mật khẩu</h1>
  <p class="lead">Tài khoản: <strong><%= student.full_name %></strong>. Các phiên đăng nhập hiện có sẽ bị vô hiệu hóa.</p>
</section>
<section class="card narrow teacher-form-card">
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/admin/students/<%= student.id %>/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Mật khẩu mới<input type="password" name="password" minlength="8" required autocomplete="new-password"></label>
    <label>Xác nhận mật khẩu<input type="password" name="confirm_password" minlength="8" required autocomplete="new-password"></label>
    <div class="form-actions">
      <button class="button" type="submit">Đặt lại mật khẩu</button>
      <a class="button secondary" href="/admin/students/<%= student.id %>">Hủy</a>
    </div>
  </form>
</section>
<%- include("../../footer") %>
