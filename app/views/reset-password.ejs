<% const pageStyles = ["auth.css"]; const pageScripts = ["auth.js"]; const pageClass = "auth-page"; %>
<%- include("header", { pageStyles, pageClass }) %>
<section class="auth-shell" aria-labelledby="reset-title">
  <article class="auth-card">
    <div class="auth-intro">
      <span class="auth-kicker"><span aria-hidden="true"></span> Bảo mật tài khoản</span>
      <h1 id="reset-title">Đặt lại mật khẩu</h1>
      <p>Chọn mật khẩu mới có ít nhất 8 ký tự.</p>
    </div>
    <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
    <% if (tokenValid) { %>
      <form class="auth-form" method="post" action="/reset-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="token" value="<%= token %>">
        <label class="auth-field" for="reset-password"><span class="field-label">Mật khẩu mới</span><span class="auth-input-wrap has-toggle"><span class="input-icon" aria-hidden="true">●</span><input id="reset-password" type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự"><button class="password-toggle" type="button" data-password-toggle aria-controls="reset-password" aria-label="Hiện mật khẩu" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c5.2 0 8.9 5.4 9 5.6a1 1 0 0 1 0 .8C20.9 11.6 17.2 17 12 17s-8.9-5.4-9-5.6a1 1 0 0 1 0-.8C3.1 10.4 6.8 5 12 5Zm0 2c-3.3 0-6 3-7 4 1 1 3.7 4 7 4s6-3 7-4c-1-1-3.7-4-7-4Zm0 1.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z"/></svg></button></span></label>
        <label class="auth-field" for="reset-confirm"><span class="field-label">Nhập lại mật khẩu</span><span class="auth-input-wrap has-toggle"><span class="input-icon" aria-hidden="true">●</span><input id="reset-confirm" type="password" name="confirm_password" required minlength="8" autocomplete="new-password" placeholder="Nhập lại mật khẩu"><button class="password-toggle" type="button" data-password-toggle aria-controls="reset-confirm" aria-label="Hiện mật khẩu" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5c5.2 0 8.9 5.4 9 5.6a1 1 0 0 1 0 .8C20.9 11.6 17.2 17 12 17s-8.9-5.4-9-5.6a1 1 0 0 1 0-.8C3.1 10.4 6.8 5 12 5Zm0 2c-3.3 0-6 3-7 4 1 1 3.7 4 7 4s6-3 7-4c-1-1-3.7-4-7-4Zm0 1.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z"/></svg></button></span></label>
        <button class="button auth-submit" type="submit">Cập nhật mật khẩu <span aria-hidden="true">→</span></button>
      </form>
    <% } %>
    <p class="auth-switch"><a href="/login">← Quay lại đăng nhập</a></p>
  </article>
</section>
<%- include("footer", { pageScripts }) %>
