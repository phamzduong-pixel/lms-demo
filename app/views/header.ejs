<% const pageTitle = title || "LMS Demo"; %>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> · LMS Demo</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">LMS Demo</a>
    <nav>
      <% if (currentUser) { %>
        <span><%= currentUser.full_name %></span>
        <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="link-button">Đăng xuất</button></form>
      <% } else { %>
        <a href="/login">Đăng nhập</a><a href="/register">Đăng ký</a>
      <% } %>
    </nav>
  </header>
  <main class="container">
