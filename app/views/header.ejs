<% const pageTitle = title || "LMS Demo"; %>
<% const requestedStyles = typeof pageStyles !== "undefined" && Array.isArray(pageStyles) ? pageStyles : []; %>
<% const requestedPageClass = typeof pageClass === "string" ? pageClass : ""; %>
<% const currentRoute = typeof currentPath === "string" ? currentPath : ""; %>
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> · LMS Demo</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <% requestedStyles.forEach((stylesheet) => { %>
    <link rel="stylesheet" href="/css/<%= stylesheet %>">
  <% }) %>
</head>
<body class="<%= requestedPageClass %>">
  <header class="topbar">
    <a class="brand" href="/" aria-label="LMS Demo - Trang chủ">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false"><path d="M2.5 8.1 12 3l9.5 5.1L12 13.2 2.5 8.1Zm3.1 3.2v4.3c0 1.7 2.9 3.5 6.4 3.5s6.4-1.8 6.4-3.5v-4.3L12 14.8l-6.4-3.5Zm14.2-.9v5.7h1.4V9.7l-1.4.7Z"/></svg>
      </span>
      <span class="brand-copy"><strong>LMS Demo</strong><small>E-learning portal</small></span>
    </a>
    <nav class="nav" aria-label="Điều hướng chính">
      <div class="nav-main">
        <a class="nav-link <%= currentRoute.startsWith('/courses') ? 'active' : '' %>" href="/courses" <% if (currentRoute.startsWith('/courses')) { %>aria-current="page"<% } %>>Khóa học</a>
        <% if (currentUser && currentUser.role === "student") { %>
          <a class="nav-link <%= currentRoute === '/student' || currentRoute.startsWith('/student/courses') ? 'active' : '' %>" href="/student" <% if (currentRoute === '/student' || currentRoute.startsWith('/student/courses')) { %>aria-current="page"<% } %>>Học của tôi</a>
          <a class="nav-link <%= currentRoute.startsWith('/student/bookmarks') ? 'active' : '' %>" href="/student/bookmarks" <% if (currentRoute.startsWith('/student/bookmarks')) { %>aria-current="page"<% } %>>Bài học đã lưu</a>
          <a class="nav-link <%= currentRoute.startsWith('/student/profile') ? 'active' : '' %>" href="/student/profile" <% if (currentRoute.startsWith('/student/profile')) { %>aria-current="page"<% } %>>Hồ sơ</a>
        <% } %>
        <% if (currentUser && currentUser.role === "teacher") { %>
          <a class="nav-link <%= currentRoute === '/teacher' || currentRoute.startsWith('/teacher/courses') ? 'active' : '' %>" href="/teacher" <% if (currentRoute === '/teacher' || currentRoute.startsWith('/teacher/courses')) { %>aria-current="page"<% } %>>Giảng dạy</a>
        <% } %>
        <% if (currentUser && currentUser.role === "admin") { %>
          <a class="nav-link <%= currentRoute.startsWith('/admin/courses') || currentRoute === '/admin' ? 'active' : '' %>" href="/admin" <% if (currentRoute.startsWith('/admin/courses') || currentRoute === '/admin') { %>aria-current="page"<% } %>>Quản trị</a>
          <a class="nav-link <%= currentRoute.startsWith('/admin/students') ? 'active' : '' %>" href="/admin/students" <% if (currentRoute.startsWith('/admin/students')) { %>aria-current="page"<% } %>>Học viên</a>
          <a class="nav-link <%= currentRoute.startsWith('/admin/teachers') ? 'active' : '' %>" href="/admin/teachers" <% if (currentRoute.startsWith('/admin/teachers')) { %>aria-current="page"<% } %>>Giáo viên</a>
        <% } %>
      </div>
      <div class="nav-account">
        <% if (currentUser) { %>
          <span class="user-label"><%= currentUser.full_name %></span>
          <form method="post" action="/logout" class="inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="nav-link link-button">Đăng xuất</button>
          </form>
        <% } else { %>
          <a class="nav-link nav-auth-link <%= currentRoute === '/login' ? 'active' : '' %>" href="/login" <% if (currentRoute === '/login') { %>aria-current="page"<% } %>>Đăng nhập</a>
          <a class="nav-link nav-auth-link <%= currentRoute === '/register' ? 'active' : '' %>" href="/register" <% if (currentRoute === '/register') { %>aria-current="page"<% } %>>Đăng ký</a>
        <% } %>
      </div>
    </nav>
  </header>
  <main class="container">
