<%- include("header") %>
<section class="hero">
  <p class="eyebrow">Nền tảng học tập</p>
  <h1>Học tập rõ ràng, tiến bộ từng bước.</h1>
  <p>Đăng ký tài khoản học viên để bắt đầu sử dụng LMS Demo.</p>
  <% if (currentUser) { %>
    <a class="button" href="<%= currentUser.role === 'admin' ? '/admin' : '/student' %>">Mở khu vực của bạn</a>
  <% } else { %>
    <a class="button" href="/register">Đăng ký học viên</a>
  <% } %>
</section>
<%- include("footer") %>
