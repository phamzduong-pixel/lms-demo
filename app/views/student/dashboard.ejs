<% const pageStyles = ["student.css"]; %>
<%- include("../header") %>
<section class="page-heading">
  <p class="eyebrow">Khu vực học viên</p>
  <h1>Học của tôi</h1>
  <p>Theo dõi tiến độ và tiếp tục bài học dang dở một cách nhanh chóng.</p>
</section>
<% if (hasAnyCourses) { %>
  <nav class="filter-tabs" aria-label="Lọc khóa học">
    <% const filters = [
      ["all", "Tất cả"],
      ["not_started", "Chưa bắt đầu"],
      ["in_progress", "Đang học"],
      ["completed", "Hoàn thành"]
    ]; %>
    <% filters.forEach(([key, label]) => { %>
      <a class="filter-tab <%= courseFilter === key ? 'selected' : '' %>" href="/student?filter=<%= key %>" <% if (courseFilter === key) { %>aria-current="page"<% } %>>
        <span><%= label %></span><small><%= filterCounts[key] %></small>
      </a>
    <% }) %>
  </nav>
<% } %>
<% if (!courses.length) { %>
  <section class="card empty-state">
    <% if (hasAnyCourses) { %>
      <h2>Không có khóa học phù hợp</h2>
      <p>Hãy chọn một bộ lọc khác để xem các khóa học đã đăng ký.</p>
      <a class="button secondary" href="/student">Xem tất cả khóa học</a>
    <% } else { %>
      <h2>Bạn chưa đăng ký khóa học nào</h2>
      <p>Hãy khám phá catalog để bắt đầu học.</p>
      <a class="button" href="/courses">Khám phá khóa học</a>
    <% } %>
  </section>
<% } else { %>
  <section class="card-grid">
    <% courses.forEach((course) => {
      const total = Number(course.total_lessons || 0);
      const completed = Number(course.completed_lessons || 0);
      const state = getCourseLearningState(course);
      const percent = total ? Math.round((completed / total) * 100) : 0;
      const statusText = state === "no_lessons" ? "Chưa có bài học" : state === "not_started" ? "Chưa bắt đầu" : state === "in_progress" ? "Đang học" : "Hoàn thành";
    %>
      <article class="card course-card student-course-card">
        <div class="section-heading">
          <span class="badge <%= state === 'completed' ? 'complete' : state === 'no_lessons' ? 'empty' : 'published' %>"><%= statusText %></span>
          <% if (state !== "no_lessons") { %><strong class="progress-percent"><%= percent %>%</strong><% } %>
        </div>
        <h2><a href="/student/courses/<%= course.id %>"><%= course.title %></a></h2>
        <p><%= course.description || "Khóa học chưa có mô tả." %></p>
        <% if (state === "no_lessons") { %>
          <p class="muted course-status-copy">Khóa học chưa có bài để tính tiến độ.</p>
        <% } else { %>
          <div class="progress-label"><span>Tiến độ</span><strong><%= completed %>/<%= total %> bài</strong></div>
          <progress value="<%= completed %>" max="<%= total %>"></progress>
        <% } %>
        <div class="actions course-actions">
          <a class="button" href="<%= getContinueLearningUrl(course) %>"><%= state === "completed" || state === "no_lessons" ? "Xem khóa học" : "Tiếp tục học" %></a>
          <a class="text-link" href="/student/courses/<%= course.id %>">Tổng quan</a>
        </div>
      </article>
    <% }) %>
  </section>
<% } %>
<%- include("../footer") %>