<% const pageStyles = ["student.css"]; %>
<%- include("../header") %>
<section class="page-heading">
  <a class="back-link" href="/student">← Khóa học của tôi</a>
  <p class="eyebrow">Đang học</p>
  <h1><%= course.title %></h1>
  <p class="lead"><%= course.description || "Khóa học chưa có mô tả." %></p>
</section>
<section class="card progress-card">
  <div class="progress-label"><span>Tiến độ khóa học</span><strong><%= progressPercent %>%</strong></div>
  <progress value="<%= completedLessons %>" max="<%= lessons.length || 1 %>"></progress>
  <p class="muted"><%= completedLessons %>/<%= lessons.length %> bài học hoàn thành</p>
</section>
<section class="lesson-stack">
  <% if (!lessons.length) { %>
    <article class="card empty-state"><p>Khóa học chưa có bài học.</p></article>
  <% } %>
  <% lessons.forEach((lesson) => { %>
    <article class="card lesson-card">
      <div class="section-heading">
        <h2><span class="lesson-number"><%= lesson.position %></span><%= lesson.title %></h2>
        <% if (lesson.completed) { %><span class="badge complete">Đã hoàn thành</span><% } %>
      </div>
      <pre class="lesson-content"><%= lesson.content || "" %></pre>
      <% if (!lesson.completed) { %>
        <form method="post" action="/student/courses/<%= course.id %>/lessons/<%= lesson.id %>/complete">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="button" type="submit">Đánh dấu hoàn thành</button>
        </form>
      <% } %>
    </article>
  <% }) %>
</section>
<%- include("../footer") %>