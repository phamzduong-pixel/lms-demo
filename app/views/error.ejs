<% const pageStyles = []; const destination = typeof homeHref !== "undefined" && homeHref ? homeHref : "/"; const destinationLabel = typeof homeLabel !== "undefined" && homeLabel ? homeLabel : "Về trang chủ"; %>
<%- include("header", { pageStyles }) %>
<section class="card error-page">
  <p class="eyebrow">LMS Demo</p>
  <h1><%= title %></h1>
  <p><%= message %></p>
  <a class="button" href="<%= destination %>"><%= destinationLabel %></a>
</section>
<%- include("footer") %>
