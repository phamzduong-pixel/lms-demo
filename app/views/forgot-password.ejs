<% const pageStyles = ["auth.css"]; const pageScripts = []; const pageClass = "auth-page"; %>
<%- include("header", { pageStyles, pageClass }) %>
<section class="auth-shell" aria-labelledby="forgot-title">
  <article class="auth-card">
    <div class="auth-intro">
      <span class="auth-kicker"><span aria-hidden="true"></span> Khôi phục tài khoản</span>
      <h1 id="forgot-title">Quên mật khẩu?</h1>
      <p>Nhập email tài khoản. Liên kết đặt lại mật khẩu có hiệu lực trong 30 phút.</p>
    </div>
    <% if (message) { %><div class="alert success" role="status"><%= message %></div><% } %>
    <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
    <% if (!message) { %>
      <form class="auth-form" method="post" action="/forgot-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="auth-field" for="forgot-email"><span class="field-label">Email</span><span class="auth-input-wrap"><span class="input-icon" aria-hidden="true">@</span><input id="forgot-email" type="email" name="email" value="<%= values.email || '' %>" required maxlength="255" autocomplete="email" placeholder="tenhocvien@example.com"></span></label>
        <button class="button auth-submit" type="submit">Gửi liên kết đặt lại <span aria-hidden="true">→</span></button>
      </form>
    <% } %>
    <p class="auth-switch"><a href="/login">← Quay lại đăng nhập</a></p>
  </article>
</section>
<%- include("footer", { pageScripts }) %>
