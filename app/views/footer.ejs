<% const requestedScripts = typeof pageScripts !== "undefined" && Array.isArray(pageScripts) ? pageScripts : []; %>
<% requestedScripts.forEach((script) => { %>
  <script src="/js/<%= script %>" defer></script>
<% }) %>
