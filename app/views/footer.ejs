  <footer class="site-footer">
    <p>© LMS Demo · Nền tảng học trực tuyến rõ ràng và thân thiện.</p>
    <nav class="footer-links" aria-label="Liên kết cuối trang">
      <a href="/">Trang chủ</a>
      <a href="/courses">Khóa học</a>
      <% if (currentUser && currentUser.role === "student") { %><a href="/student">Học của tôi</a><% } %>
      <% if (currentUser && currentUser.role === "teacher") { %><a href="/teacher">Giảng dạy</a><% } %>
      <% if (currentUser && currentUser.role === "admin") { %><a href="/admin">Quản trị</a><% } %>
