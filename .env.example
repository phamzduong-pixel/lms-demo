MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MYSQL_PASSWORD=replace_with_a_different_strong_app_password
SESSION_SECRET=replace_with_a_long_random_session_secret
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Security and proxy settings
TRUST_PROXY_HOPS=1
SECURITY_HASH_SECRET=replace_with_a_different_long_random_secret
REQUEST_BODY_LIMIT=2mb
JSON_BODY_LIMIT=64kb
SECURITY_EVENT_RETENTION_DAYS=90
SECURITY_EVENT_GROUP_WINDOW_MINUTES=15
SECURITY_CLEANUP_BATCH_SIZE=500
RATE_LIMIT_RETENTION_HOURS=72

# Required only when using docker-compose.monitoring.yml with --profile monitoring
MYSQL_MONITOR_PASSWORD=replace_with_a_long_hex_monitor_password
MYSQL_EXPORTER_UID=1000
MYSQL_EXPORTER_GID=1000
MYSQL_EXPORTER_CNF_PATH=/absolute/path/to/mysql-exporter.cnf
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_grafana_password
